RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Pretty API: /api/transactions/12 -> index.php?id=12
RewriteRule ^api/transactions/([0-9]+)/?$ api/transactions/index.php?id=$1 [QSA,L]
RewriteRule ^api/goals/([0-9]+)/?$ api/goals/index.php?id=$1 [QSA,L]

# PHP built-in server ignores .htaccess — router.php handles that.
